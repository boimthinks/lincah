---
import Layout from '../layouts/Layout.astro';
import PriceAdmin from '../components/PriceAdmin';
import { getCollection } from 'astro:content';

const routes = await getCollection('rute');
const capitalize = (str: string) => str.toLowerCase().replace(/\b\w/g, l => l.toUpperCase());

const routesData = routes.map(r => ({
  id: r.id,
  ...r.data,
  from: capitalize(r.data.from),
  to: capitalize(r.data.to)
}));

const title = "Harga Rute Admin Lincah Travel";
const description = "Halaman internal panel admin Lincah Travel untuk memantau daftar harga tiket, rute perjalanan, dan tarif travel door to door.";
---

<Layout title={title} description={description} hideFloatingWhatsApp={true} noindex={true}>
  <PriceAdmin routes={routesData} client:load />
</Layout>