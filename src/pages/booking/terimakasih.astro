---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/NavbarInner.tsx';
import Footer from '../../components/Footer.astro';
import BookingSuccess from '../../components/BookingSuccess.tsx';

const title = "Terima Kasih Sudah Booking | Lincah Travel Palembang";
const description = "Konfirmasi pemesanan tiket travel door-to-door Lincah Travel. Pesanan Anda sedang menunggu konfirmasi admin via WhatsApp.";
---

<Layout title={title} description={description} noindex={true} hideFloatingWhatsApp={true}>
  <Navbar client:load />

  <main class="min-h-screen bg-slate-950 text-white pt-28 pb-20 px-4">
    <div class="max-w-2xl mx-auto text-center space-y-4 mb-10">
      <h1 class="text-3xl sm:text-4xl font-black uppercase tracking-tight">
        Pemesanan Berhasil Dikirim
      </h1>

      <p class="text-slate-300 text-sm sm:text-base leading-relaxed max-w-xl mx-auto">
        Berikut ringkasan pemesanan perjalanan Anda. Simpan nomor referensi sebagai bukti booking.
      </p>
    </div>

    <BookingSuccess client:load />
  </main>

  <Footer />
</Layout>
