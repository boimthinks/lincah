---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/NavbarHome.tsx';
import Hero from '../components/Hero.tsx';
import Features from '../components/Features.astro';
import RoutesPrices from '../components/RoutesPrices.tsx';
import Fleet from '../components/Fleet.astro';
import HowToBook from '../components/HowToBook.astro';
import Testimonials from '../components/Testimonials.astro';
import FAQ from '../components/FAQ.tsx';
import BlogCard from '../components/BlogCard.astro';
import Footer from '../components/Footer.astro';
import { getCollection, getEntry } from 'astro:content';

const routes = await getCollection('rute');
const vehicles = await getCollection('vehicles');
const testimonials = await getCollection('testimonials');
const faqs = await getCollection('faq');
const blogPosts = await getCollection('blog');

// Ambil 6 artikel blog terbaru untuk cardview di homepage
const latestBlogPosts = [...blogPosts]
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime())
  .slice(0, 6);

const cityImagesEntry = await getEntry('city_images', 'city-images').catch(() => null);
const cityImages = cityImagesEntry?.data.cities || {};

// Helper function to capitalize city names for display
const capitalize = (str: string) => str.split(' ').map(word => word.charAt(0).toUpperCase() + word.slice(1)).join(' ');

// Map collection data to match the component props if needed
const routesData = routes.map((r: any) => ({ 
  id: r.id, 
  ...r.data,
  from: capitalize(r.data.from),
  to: capitalize(r.data.to)
}));
const vehiclesData = vehicles.map((v: any) => ({ id: v.id, ...v.data }));
const testimonialsData = testimonials.map((t: any) => ({ id: t.id, ...t.data }));
const faqsData = faqs.map((f: any) => ({ id: f.id, ...f.data }));

const ADMIN_WA = '6281369231893';
const title = "Lincah Travel Palembang ke Sumatera Selatan, Murah Cepat, Aman dan Nyaman";
const description = "Lincah Travel Palembang: Layanan antar jemput door to door rute Baturaja, Lampung, Jambi & seluruh Sumsel. Armada Hiace/Innova VIP, harga mulai Rp80rb. Pesan via WA 24 jam!";
---

<Layout title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "Lincah Travel",
    "url": "https://lincahtravel.web.id/",
    "potentialAction": {
      "@type": "SearchAction",
      "target": {
        "@type": "EntryPoint",
        "urlTemplate": "https://lincahtravel.web.id/travel?q={search_term_string}"
      },
      "query-input": "required name=search_term_string"
    }
  })} />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqsData.map(f => ({
      "@type": "Question",
      "name": f.question,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": f.answer
      }
    }))
  })} />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "Lincah Travel",
    "url": "https://lincahtravel.web.id/",
    "logo": "https://lincahtravel.web.id/favicon.svg",
    "contactPoint": {
      "@type": "ContactPoint",
      "telephone": "+6281369231893",
      "contactType": "customer service",
      "availableLanguage": ["Indonesian"]
    },
    "sameAs": [
      "https://www.tiktok.com/@lincahtravelpalembang",
      "https://www.youtube.com/@lincahtravel",
      "https://www.linkedin.com/company/lincah-travel/",
      "https://id.pinterest.com/lincahtravel/"
    ],
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "Lorong Tj. Burung Utama, Bukit Lama, Kec. Ilir Bar. I",
      "addressLocality": "Kota Palembang",
      "addressRegion": "Sumatera Selatan",
      "postalCode": "30139",
      "addressCountry": "ID"
    }
  })} />

  <Navbar client:load />
  <main>
    <Hero routes={routesData} client:load />
    <Features />
    <RoutesPrices routes={routesData} cityImages={cityImages} bookingDirect={true} client:load />
    <Fleet vehicles={vehiclesData} />
    <HowToBook />
    <script>
      // Hubungkan tombol di HowToBook dengan halaman booking
      document.getElementById('how-to-book-btn')?.addEventListener('click', () => {
        window.location.href = '/booking';
      });
    </script>
    <Testimonials testimonials={testimonialsData} />

    {/* Blog Cardview Section */}
    <section id="blog-terbaru" class="py-20 sm:py-28 bg-slate-50 overflow-hidden text-left border-t border-slate-200">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        {/* Header Section */}
        <div class="text-center max-w-3xl mx-auto mb-16 sm:mb-20">
          <span class="inline-flex items-center gap-1.5 text-[10px] font-bold uppercase tracking-widest text-blue-700 bg-blue-50 px-3.5 py-2 border border-blue-200 rounded-none mb-3">
            ARTIKEL & TIPS PERJALANAN
          </span>
          <h2 class="text-3xl sm:text-4xl font-extrabold text-blue-900 tracking-tight uppercase">
            Blog & Info Terbaru Lincah Travel
          </h2>
          <p class="text-sm sm:text-base text-slate-500 mt-3 font-normal max-w-xl mx-auto leading-relaxed">
            Temukan tips perjalanan, panduan rute, dan informasi terbaru seputar layanan travel door-to-door dari Palembang ke seluruh Sumatera Selatan dan sekitarnya.
          </p>
        </div>

        {/* 6 Blog Cards */}
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
          {latestBlogPosts.map((post) => (
            <BlogCard post={post} />
          ))}
        </div>

        {/* Link ke halaman blog */}
        <div class="text-center mt-12">
          <a
            href="/blog"
            class="inline-flex items-center justify-center gap-2 bg-blue-900 hover:bg-blue-800 text-white font-extrabold uppercase tracking-widest text-xs px-8 py-4 transition-colors"
          >
            Lihat Semua Artikel
          </a>
        </div>
      </div>
    </section>

    <FAQ faqs={faqsData} client:load />
  </main>
  <Footer />
</Layout>
