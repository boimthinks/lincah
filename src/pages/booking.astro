---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/NavbarInner.tsx';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';
import BookingModal from '../components/BookingModal.tsx';
import { useState } from 'react';

const routes = await getCollection('rute');
const routesData = routes.map((r: any) => ({
  id: r.id,
  from: r.data.from,
  to: r.data.to,
  price: r.data.price,
  departureTimes: r.data.departureTimes || ["08:00 WIB", "15:00 WIB", "20:00 WIB"],
  type: r.data.type
}));

const title = "Uji Coba Form Booking | Lincah Travel Palembang";
const description = "Halaman pengujian form booking tiket Lincah Travel dengan integrasi Supabase dan WhatsApp Admin.";
---

<Layout title={title} description={description}>
  <Navbar client:load />

  <main class="min-h-screen bg-slate-950 text-white pt-28 pb-20 px-4">
    <div class="max-w-3xl mx-auto text-center space-y-6">
      <div class="inline-block bg-yellow-400/10 border border-yellow-400/20 px-3 py-1">
        <span class="text-xs font-bold text-yellow-400 uppercase tracking-widest">Testing Mode / Halaman Khusus Booking</span>
      </div>

      <h1 class="text-3xl sm:text-5xl font-black uppercase tracking-tight">
        Formulir Pemesanan Travel Palembang
      </h1>

      <p class="text-slate-300 text-sm sm:text-base leading-relaxed max-w-xl mx-auto">
        Silakan klik tombol di bawah ini untuk membuka popup formulir pemesanan tiket travel door-to-door (Palembang ke berbagai daerah di Sumsel/Sumatera).
      </p>

      {/* Demo Booking Trigger Component */}
      <div class="pt-6">
        <button
          id="open-booking-btn"
          class="bg-yellow-400 hover:bg-yellow-300 text-blue-950 font-black uppercase tracking-widest text-sm px-8 py-4 shadow-xl transition-all cursor-pointer inline-flex items-center gap-2"
        >
          <span>🚀 Buka Form Booking (Popup)</span>
        </button>
      </div>
    </div>

    {/* Container React Island */}
    <div id="booking-modal-root" data-routes={JSON.stringify(routesData)}></div>
  </main>

  <script>
    import React from 'react';
    import ReactDOM from 'react-dom/client';
    import BookingModal from '../components/BookingModal.tsx';

    const rootEl = document.getElementById('booking-modal-root');
    if (rootEl) {
      const routes = JSON.parse(rootEl.dataset.routes || '[]');
      
      let isOpen = false;
      const root = ReactDOM.createRoot(rootEl);

      function renderModal() {
        root.render(
          React.createElement(BookingModal, {
            isOpen: isOpen,
            onClose: () => {
              isOpen = false;
              renderModal();
            },
            routes: routes
          })
        );
      }

      renderModal();

      document.getElementById('open-booking-btn')?.addEventListener('click', () => {
        isOpen = true;
        renderModal();
      });
    }
  </script>

  <Footer />
</Layout>
