---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/NavbarInner.tsx';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';
import BookingModal from '../components/BookingModal.tsx';

const routes = await getCollection('rute');
const routesData = routes.map((r: any) => ({
  id: r.id,
  from: r.data.from,
  to: r.data.to,
  price: r.data.price,
  departureTimes: r.data.departureTimes || ["08:00 WIB", "15:00 WIB", "20:00 WIB"],
  type: r.data.type
}));

const title = "Form Pemesanan Tiket | Lincah Travel Palembang";
const description = "Halaman formulir pemesanan tiket travel door-to-door (Palembang ke berbagai daerah di Sumsel/Sumatera) secara online.";
---

<Layout title={title} description={description}>
  <Navbar client:load />

  <main class="min-h-screen bg-slate-950 text-white pt-28 pb-20 px-4">
    <div class="max-w-3xl mx-auto text-center space-y-6 mb-10">
      <h1 class="text-3xl sm:text-5xl font-black uppercase tracking-tight">
        Formulir Pemesanan Travel Palembang
      </h1>

      <p class="text-slate-300 text-sm sm:text-base leading-relaxed max-w-xl mx-auto">
        Silakan lengkapi formulir di bawah ini untuk memesan tiket travel door-to-door dengan mudah. data Anda akan otomatis terkirim ke WhatsApp Admin kami.
      </p>
    </div>

    {/* Form inline */}
    <div class="max-w-2xl mx-auto bg-white text-slate-900 shadow-2xl">
      <BookingModal routes={routesData} isPage={true} isOpen={true} onClose={() => {}} client:load />
    </div>
  </main>

  <Footer />
</Layout>
