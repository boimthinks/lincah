---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/NavbarInner.tsx';
import Footer from '../../components/Footer.astro';
import RouteTicketPopup from '../../components/RouteTicketPopup.astro';
import OtherRoutes from '../../components/OtherRoutes.astro';
import SidebarCTA from '../../components/SidebarCTA.astro';
import RouteFAQ from '../../components/RouteFAQ.astro';
import GoogleSourcePreferences from '../../components/GoogleSourcePreferences.astro';

import { getCollection, getEntry, render } from 'astro:content';

export async function getStaticPaths() {
  const routes = await getCollection('rute');
  return routes.map((entry: any) => {
    const fromSlug = entry.data.from.toLowerCase().replace(/\s+/g, '-').replace(/[()]/g, '');
    const toSlug = entry.data.to.toLowerCase().replace(/\s+/g, '-').replace(/[()]/g, '');
    return {
      params: { from: fromSlug, to: toSlug },
      props: { entry, fromSlug, toSlug },
    };
  });
}

const { entry, fromSlug, toSlug } = Astro.props as { entry: any, fromSlug: string, toSlug: string };
const { from, to, price, duration, departureTimes, description, img, distance, type } = entry.data;

const hasBody = !!entry.body;
let Content = null;
if (hasBody) {
  const rendered = await render(entry).catch(() => ({ Content: null }));
  Content = rendered.Content;
}

const capitalize = (str: string) => str.split(' ').map(word => word.charAt(0).toUpperCase() + word.slice(1)).join(' ');

const title = `Travel ${capitalize(from)} ke ${capitalize(to)} • Harga Tiket, Agen & Jadwal Lincah Travel`;

const metaDescription = `Harga tiket travel ${capitalize(from)} ${capitalize(to)} mulai Rp ${price.toLocaleString('id-ID')}. Cek ongkos travel, jadwal, jasa kirim paket via travel, agen & loket, serta nomor telepon 0813-6923-1893. Layanan door-to-door Lincah Travel.`;

// Fetch additional data for 'from' and 'to' cities
const fromCitySlug = from.toLowerCase().replace(/\s+/g, '-').replace(/[()]/g, '');
const toCitySlug = to.toLowerCase().replace(/\s+/g, '-').replace(/[()]/g, '');

const cityImagesEntry = await getEntry('city_images', 'city-images').catch(() => null);
const cityImages = cityImagesEntry?.data.cities || {};

// Determine image to use: check global city images first, then fall back to route img, then a generic placeholder
const resolvedImg = cityImages[toCitySlug] || img || "https://images.unsplash.com/photo-1544620347-c4fd4a3d5957?auto=format&fit=crop&q=80&w=1200";
const imgAlt = `travel ${from} ${to} murah`;


---

<Layout title={title} description={metaDescription}>
  <meta property="og:title" content={title} />
  <meta property="og:description" content={metaDescription} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={`https://lincahtravel.web.id/${fromCitySlug}/${toCitySlug}`} />
  <meta property="og:image" content={resolvedImg.startsWith('http') ? resolvedImg : `https://lincahtravel.web.id${resolvedImg}`} />
  <meta property="og:site_name" content="Lincah Travel" />
  <meta property="og:locale" content="id_ID" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={metaDescription} />
  <meta name="twitter:image" content={resolvedImg.startsWith('http') ? resolvedImg : `https://lincahtravel.web.id${resolvedImg}`} />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Beranda",
        "item": "https://lincahtravel.web.id/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Travel",
        "item": "https://lincahtravel.web.id/travel"
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": `Travel ${capitalize(from)} ke ${capitalize(to)}`,
        "item": `https://lincahtravel.web.id/${fromCitySlug}/${toCitySlug}`
      }
    ]
  })} />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Product",
    "name": `Travel ${capitalize(from)} ke ${capitalize(to)}`,
    "description": metaDescription,
    "image": resolvedImg,
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": "4.8",
      "bestRating": "5",
      "worstRating": "1",
      "ratingCount": 142,
      "reviewCount": 142
    },
    "offers": {
      "@type": "Offer",
      "url": `https://lincahtravel.web.id/${fromCitySlug}/${toCitySlug}`,
      "price": price,
      "priceCurrency": "IDR",
      "availability": "https://schema.org/InStock",
      "sku": `TRV-${fromSlug}-${toSlug}`,
      "brand": { "@type": "Brand", "name": "Lincah Travel" },
      "shippingDetails": {
        "@type": "OfferShippingDetails",
        "shippingRate": { "@type": "MonetaryAmount", "value": "0", "currency": "IDR" },
        "shippingDestination": { "@type": "DefinedRegion", "addressCountry": "ID" }
      },
      "hasMerchantReturnPolicy": {
        "@type": "MerchantReturnPolicy",
        "applicableCountry": "ID",
        "returnPolicyCategory": "https://schema.org/MerchantReturnFiniteReturnWindow",
        "merchantReturnDays": 30
      },
      "seller": {
        "@type": "LocalBusiness",
        "name": "Lincah Travel",
        "telephone": "+6281369231893",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "Lorong Tj. Burung Utama, Bukit Lama, Kec. Ilir Bar. I",
          "addressLocality": "Kota Palembang",
          "addressRegion": "Sumatera Selatan",
          "postalCode": "30139",
          "addressCountry": "ID"
        }
      }
    }
  })} />

  <Navbar client:load />
      <main class="pt-24 bg-slate-50">
        <RouteTicketPopup from={from} to={to} price={price} />
        <section class="pb-12 sm:pb-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <nav class="flex items-center space-x-2 text-xs font-medium text-slate-500 uppercase tracking-wider pt-2 pb-2 sm:pt-4 sm:pb-3">
          <a href="/" class="hover:text-blue-700 transition-colors">Lincah</a>
          <span class="text-slate-300">/</span>
          <a href="/travel" class="hover:text-blue-700 transition-colors">Travel</a>
          <span class="text-slate-300">/</span>
          <span class="text-slate-900 font-bold">{capitalize(from)} {capitalize(to)}</span>
        </nav>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
          <div class="lg:col-span-8">
            <div class="bg-white border border-slate-200 overflow-hidden shadow-sm">
              {resolvedImg && (
                <img src={resolvedImg} alt={imgAlt} title={imgAlt} width="640" height="480" class="w-full aspect-[4/3] object-cover" />
              )}
              <div class="p-8">
                <div class="flex items-center gap-2 text-blue-700 font-bold text-xs uppercase tracking-widest mb-4">
                  <span class="w-2 h-2 bg-blue-700"></span>
                  Travel {capitalize(from)} 
                </div>
                <h1 class="text-3xl sm:text-4xl font-black text-blue-900 uppercase mb-6">
                  Travel {capitalize(from)} {capitalize(to)}
                </h1>
                
                <div class="prose prose-slate max-w-none mb-8">
                  <p class="text-lg text-slate-600 leading-relaxed">
                    {description || `Nikmati layanan travel terbaik dari ${capitalize(from)} menuju ${capitalize(to)} dengan sistem antar jemput alamat (door to door). Armada prima, tepat waktu, dan driver berpengalaman.`}
                  </p>
                </div>

                <div class="grid grid-cols-2 sm:grid-cols-3 gap-6 py-6 border-y border-slate-100 mb-8">
                  <div>
                    <span class="block text-[10px] font-bold text-slate-400 uppercase tracking-wider">Tarif Flat</span>
                    <span class="text-xl font-bold text-blue-900">Rp {price.toLocaleString('id-ID')}</span>
                  </div>
                  <div>
                    <span class="block text-[10px] font-bold text-slate-400 uppercase tracking-wider">Durasi</span>
                    <span class="text-xl font-bold text-slate-700">{duration}</span>
                  </div>
                  <div class="col-span-2 sm:col-span-1">
                    <span class="block text-[10px] font-bold text-slate-400 uppercase tracking-wider">Keberangkatan</span>
                    <div class="flex flex-wrap gap-1 mt-1">
                      {departureTimes.map(   (time: string) => (
                        <span class="bg-blue-50 text-blue-700 text-[10px] font-bold px-2 py-0.5 border border-blue-100">{time}</span>
                      ))}
                    </div>
                  </div>
                </div>

                <div class="bg-blue-50 border-l-4 border-blue-600 p-4 mb-8">
                  <p class="text-sm text-blue-800 font-medium">
                    Layanan door-to-door: Kami menjemput Anda di alamat asal dan mengantar langsung ke alamat tujuan di {capitalize(to)}.
                  </p>
                </div>

        <div class="mt-12 bg-gradient-to-r from-blue-900 to-blue-700 p-8 sm:p-10 text-white shadow-lg flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
          <div>
            <h2 class="text-xl sm:text-2xl font-black uppercase tracking-tight">Siap Berangkat ke {capitalize(to)}?</h2>
            <p class="text-blue-100 text-sm mt-2 leading-relaxed max-w-lg">
              Pesan sekarang lewat formulir online: tentukan tanggal, jam, dan titik jemput di peta. Admin kami akan konfirmasi ketersediaan kursi via WhatsApp.
            </p>
          </div>
          <a
            href={`/booking?route=${entry.id}`}
            class="bg-yellow-400 hover:bg-yellow-300 text-blue-950 font-extrabold text-xs uppercase tracking-widest px-8 py-4 rounded-none shadow-md transition-all whitespace-nowrap cursor-pointer"
          >
            Pesan Tiket
          </a>
        </div>

        {/* BAGIAN BARU: TARIF & HARGA — target keyword "harga tiket travel", "ongkos travel" */}
        {/* Kalimat di-parameterisasi dengan distance/duration/type agar unik per rute, bukan boilerplate */}
        <div class="mt-12">
          <h2 class="text-2xl font-extrabold text-blue-900 uppercase tracking-tight mb-6">Harga Tiket Travel {capitalize(from)} {capitalize(to)}</h2>
          <p class="text-slate-600 leading-relaxed mb-4">
            Tarif flat travel {capitalize(from)} ke {capitalize(to)} adalah <strong>Rp {price.toLocaleString('id-ID')}</strong> untuk sekali jalan door-to-door. Rute sepanjang <strong>{distance}</strong> ini ditempuh sekitar <strong>{duration}</strong> melalui jalur {type === 'sumatera selatan' ? 'utama Sumatera Selatan' : type}. Harga sudah all-in: penjemputan dari alamat Anda di {capitalize(from)} dan antar langsung ke tujuan di {capitalize(to)}, tanpa biaya terminal.
          </p>
          <p class="text-slate-600 leading-relaxed">
            Ongkos travel {capitalize(from)} {capitalize(to)} bersifat tetap (flat) untuk seluruh titik jemput dalam area jangkauan kota {capitalize(from)}. Tidak ada biaya tersembunyi—bandingkan dengan transportasi umum yang meminta Anda transit dan bayar lagi di tengah jalan.
          </p>
        </div>

        <div class="mt-12">
          <h2 class="text-2xl font-extrabold text-blue-900 uppercase tracking-tight mb-6">Ongkos Travel {capitalize(from)} {capitalize(to)}</h2>
          <p class="text-slate-600 leading-relaxed">
            Ongkos travel {capitalize(from)} {capitalize(to)} saat ini <strong>Rp {price.toLocaleString('id-ID')}</strong> untuk jarak {distance}. Keberangkatan tersedia setiap hari pukul <strong>{departureTimes.join(', ')}</strong>—pilih jam yang paling pas dengan jadwal Anda, driver kami jemput tepat di pintu rumah dan antar hingga alamat tujuan.
          </p>
        </div>

        {Content && (
          <div class="route-content max-w-none mt-10 mb-10">
            <Content />
          </div>
        )}

        {/* BAGIAN BARU: JASA PENGIRIMAN / TITIP PAKET KILAT — target keyword "kirim paket via travel" */}
        <div class="mt-12">
          <h2 class="text-2xl font-extrabold text-blue-900 uppercase tracking-tight mb-4">Kirim Paket via Travel {capitalize(from)} {capitalize(to)} (Sameday)</h2>
          <p class="text-slate-600 leading-relaxed mb-4">
            Membutuhkan kiriman barang atau berkas mendesak yang wajib tiba di hari yang sama? Selain melayani penumpang, Lincah Travel memfasilitasi layanan <strong>kirim paket via travel {capitalize(from)} {capitalize(to)}</strong> dengan metode titip kilat door-to-door. Paket Anda dibawa langsung menggunakan armada pada jadwal keberangkatan terdekat, sehingga tiba jauh lebih cepat tanpa risiko tertimbun di gudang sortir ekspedisi biasa.
          </p>
          <p class="text-slate-600 leading-relaxed">
            Layanan pengiriman ini sangat fleksibel untuk beragam kebutuhan: dokumen penting, kiriman kuliner/oleh-oleh (seperti pempek vakum), paket belanjaan toko, hingga suku cadang (sparepart). Driver kami siap mengambil paket di alamat Anda di {capitalize(from)} dan membawanya langsung ke tangan penerima di {capitalize(to)}.
          </p>
        </div>

        {/* BAGIAN BARU: AGEN & LOKET TRAVEL + KONTAK — target keyword "agen travel", "loket travel", "no telp", "nomor telepon" */}
        {/* DIKECILKAN (C): cukup 1 baris kontak, bukan paragraf panjang berulang di 56 halaman */}
        <div class="mt-12 bg-slate-50 border border-slate-200 p-6 sm:p-8">
          <h2 class="text-2xl font-extrabold text-blue-900 uppercase tracking-tight mb-4">Agen & Loket Travel {capitalize(from)} {capitalize(to)}</h2>
          <p class="text-slate-600 leading-relaxed mb-4">
            Lincah Travel melayani rute {capitalize(from)} ke {capitalize(to)}. Loket & admin kami siap 24 jam di <strong>Lorong Tj. Burung Utama, Bukit Lama, Kota Palembang</strong> — atau langsung hubungi <a href="https://wa.me/6281369231893" class="text-blue-700 font-bold hover:underline">0813-6923-1893</a> (WhatsApp) tanpa perlu datang ke loket.
          </p>
          <div class="flex flex-wrap gap-3 mt-5">
            <a
              href={`https://wa.me/6281369231893?text=Halo%20Lincah%20Travel%2C%20saya%20mau%20tanya%20travel%20${encodeURIComponent(capitalize(from))}%20ke%20${encodeURIComponent(capitalize(to))}`}
              class="inline-block bg-blue-700 hover:bg-blue-800 text-white font-extrabold text-xs uppercase tracking-widest px-6 py-3 rounded-none shadow-md transition-all cursor-pointer"
            >
              Hubungi Agen Travel (WhatsApp)
            </a>
            <a
              href={`https://wa.me/6281369231893?text=Halo%20Lincah%20Travel%2C%20saya%20mau%20titip%20kirim%20paket%20${encodeURIComponent(capitalize(from))}%20ke%20${encodeURIComponent(capitalize(to))}`}
              class="inline-block bg-emerald-700 hover:bg-emerald-800 text-white font-extrabold text-xs uppercase tracking-widest px-6 py-3 rounded-none shadow-md transition-all cursor-pointer"
            >
              Kirim Paket Kilat (WhatsApp)
            </a>
          </div>
        </div>

        {/* Tombol Google Source Preferences */}
        <GoogleSourcePreferences />

        {/* BAGIAN BARU: FAQ — target long-tail keyword */}
        <RouteFAQ from={from} to={to} price={price} />

               </div>
             </div>
           </div>
           <div class="lg:col-span-4 space-y-6 lg:sticky lg:top-28 h-fit">
            <SidebarCTA 
              title="Pesan Travel Sekarang" 
              description="Isi formulir online, tentukan titik jemput di peta, dan admin kami akan konfirmasi kursi via WhatsApp." 
              routeId={entry.id}
            />
            <OtherRoutes currentRouteId={entry.id} />
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>