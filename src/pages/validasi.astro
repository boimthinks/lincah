---
const siteTitle = 'Validasi Nota | Lincah Travel';
const siteUrl = 'https://lincahtravel.web.id';
const supabaseUrl = 'https://wrllosddilihcoqofhdr.supabase.co';
const supabaseAnonKey = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6IndybGxvc2RkaWxpaGNvcW9maGRyIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODIwMzEzMDgsImV4cCI6MjA5NzYwNzMwOH0.Om4UkzVF0Qobqkva5yZuKu5FSAg8GI00dYUiOaaIsPQ';
---

<!doctype html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{siteTitle}</title>
  <meta name="description" content="Validasi Nota Perjalanan Lincah Travel" />
  <meta name="robots" content="noindex, nofollow" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet" />
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
      background: #f1f5f9;
      color: #1e293b;
      min-height: 100vh;
    }
    .loading-state {
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
      flex-direction: column;
      gap: 16px;
    }
    .loading-state .spinner {
      width: 40px; height: 40px;
      border: 4px solid #e2e8f0;
      border-top-color: #1e3a8a;
      border-radius: 50%;
      animation: spin 0.8s linear infinite;
    }
    @keyframes spin { to { transform: rotate(360deg); } }
    .loading-state p {
      font-size: 14px; color: #64748b; font-weight: 500;
    }
    .error-state {
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
      flex-direction: column;
      gap: 16px;
      padding: 24px;
      text-align: center;
    }
    .error-state .icon { font-size: 48px; color: #ef4444; }
    .error-state h2 { font-size: 20px; color: #1e293b; font-weight: 700; }
    .error-state p { font-size: 14px; color: #64748b; max-width: 400px; line-height: 1.6; }
    .error-state a {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 10px 24px;
      background: #1e3a8a;
      color: white;
      text-decoration: none;
      font-size: 13px;
      font-weight: 600;
      border-radius: 8px;
      margin-top: 8px;
    }
    .nota-container {
      max-width: 520px;
      margin: 40px auto;
      background: white;
      box-shadow: 0 4px 24px rgba(0,0,0,0.08);
    }
    .nota-header {
      background: linear-gradient(135deg, #1e3a8a 0%, #2563eb 100%);
      color: white;
      padding: 32px 36px 28px;
      text-align: center;
    }
    .nota-header .brand {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 12px;
      margin-bottom: 6px;
    }
    .nota-header .brand svg { width: 40px; height: 40px; flex-shrink: 0; }
    .nota-header .brand-name {
      font-size: 22px;
      font-weight: 900;
      letter-spacing: -0.5px;
      text-transform: uppercase;
    }
    .nota-header .brand-name span { color: #fbbf24; }
    .nota-header .tagline {
      font-size: 10px;
      letter-spacing: 3px;
      text-transform: uppercase;
      opacity: 0.8;
      font-weight: 600;
    }
    .nota-body { padding: 32px 36px; }
    .nota-title {
      text-align: center;
      margin-bottom: 24px;
    }
    .nota-title .sub {
      font-size: 10px;
      color: #64748b;
      letter-spacing: 2px;
      font-weight: 700;
      text-transform: uppercase;
      margin-bottom: 4px;
    }
    .nota-title .no-nota {
      font-size: 16px;
      font-weight: 800;
      color: #1e3a8a;
      letter-spacing: 0.5px;
    }
    .nota-divider {
      border: none;
      height: 2px;
      background: linear-gradient(to right, transparent, #e2e8f0, transparent);
      margin: 0 0 24px;
    }
    .nota-table { width: 100%; border-collapse: collapse; font-size: 14px; }
    .nota-table td {
      padding: 10px 0;
      border-bottom: 1px solid #f1f5f9;
    }
    .nota-table .label {
      color: #64748b;
      font-weight: 600;
      width: 140px;
      font-size: 13px;
    }
    .nota-table .value {
      color: #1e293b;
      font-weight: 600;
    }
    .nota-table .value-highlight {
      color: #1e3a8a;
      font-weight: 800;
      font-size: 18px;
    }
    .nota-table tr:last-child td {
      border-bottom: none;
      padding-top: 14px;
    }
    .nota-table tr:last-child .label {
      font-size: 14px;
      color: #1e3a8a;
    }
    .nota-qr-section {
      text-align: center;
      padding: 24px 0 16px;
      margin-top: 8px;
      border-top: 2px dashed #e2e8f0;
    }
    .nota-qr-section #qr-container {
      display: inline-block;
      padding: 12px;
      background: white;
      border: 2px solid #e2e8f0;
    }
    .nota-qr-section .qr-label {
      font-size: 10px;
      color: #94a3b8;
      margin-top: 8px;
      letter-spacing: 0.5px;
      font-weight: 500;
    }
    .nota-footer {
      padding: 20px 36px;
      background: #f8fafc;
      border-top: 1px solid #e2e8f0;
      text-align: center;
      font-size: 11px;
      color: #94a3b8;
      line-height: 1.8;
    }
    .nota-footer .company { font-weight: 700; color: #475569; }
    .nota-footer .disclaimer {
      margin-top: 8px;
      font-style: italic;
      font-size: 10px;
    }
    .action-bar {
      max-width: 520px;
      margin: 0 auto 40px;
      display: flex;
      gap: 12px;
      padding: 0 4px;
    }
    .action-bar button {
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      padding: 14px 20px;
      font-size: 14px;
      font-weight: 700;
      font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
      border: none;
      cursor: pointer;
      transition: all 0.2s;
    }
    .action-bar .btn-print {
      background: #1e3a8a;
      color: white;
    }
    .action-bar .btn-print:hover { background: #1e40af; }
    .action-bar .btn-wa {
      background: #25D366;
      color: white;
    }
    .action-bar .btn-wa:hover { background: #1da851; }
    .nota-valid {
      max-width: 520px;
      margin: 0 auto 40px;
      text-align: center;
      padding: 12px;
      background: #ecfdf5;
      border: 1px solid #a7f3d0;
      font-size: 12px;
      font-weight: 600;
      color: #059669;
    }
    .nota-valid .material-icons {
      font-size: 16px;
      vertical-align: middle;
      margin-right: 4px;
    }
    @media (max-width: 600px) {
      .nota-container { margin: 16px; }
      .nota-header { padding: 24px 20px 20px; }
      .nota-body { padding: 24px 20px; }
      .nota-footer { padding: 16px 20px; }
      .action-bar { margin: 0 16px 24px; flex-direction: column; }
      .nota-valid { margin: 0 16px 24px; }
    }
    @media print {
      body {
        background: white;
        padding: 0 !important;
      }
      .action-bar, .nota-valid, .no-print { display: none !important; }
      .nota-container {
        margin: 0;
        box-shadow: none;
        max-width: 100%;
      }
      .nota-header { background: #1e3a8a !important; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
      .nota-header .brand-name span { color: #fbbf24 !important; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
      .nota-divider { background: #e2e8f0 !important; -webkit-print-color-adjust: exact; }
      .nota-qr-section #qr-container { border-color: #e2e8f0 !important; }
      .nota-footer { background: #f8fafc !important; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
      @page { margin: 0; }
    }
  </style>
</head>
<body>
  <div id="app">
    <div class="loading-state" id="loading-state">
      <div class="spinner"></div>
      <p>Memuat data nota...</p>
    </div>
  </div>

  <script define:vars={{ supabaseUrl, supabaseAnonKey, siteUrl }}>
    const SUPABASE_URL = supabaseUrl;
    const SUPABASE_ANON_KEY = supabaseAnonKey;
    const SITE_URL = siteUrl;

    const { createClient } = supabase;
    const db = createClient(SUPABASE_URL, SUPABASE_ANON_KEY);

    function getNotaId() {
      const pathMatch = window.location.pathname.match(/\/validasi\/(.+)/);
      if (pathMatch) return pathMatch[1];
      const params = new URLSearchParams(window.location.search);
      return params.get('id') || '';
    }

    function formatDate(dateStr) {
      if (!dateStr) return '-';
      const d = new Date(dateStr);
      return d.toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' });
    }

    function formatCurrency(amount) {
      const num = Number(amount) || 0;
      return 'Rp ' + num.toLocaleString('id-ID');
    }

    function formatWhatsApp(phone) {
      if (!phone) return '';
      if (phone.startsWith('62')) return phone;
      if (phone.startsWith('0')) return '62' + phone.substring(1);
      return '62' + phone.replace(/\D/g, '');
    }

    function capitalize(str) {
      if (!str) return '';
      return str.split(' ').map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(' ');
    }

    function showError(message) {
      document.getElementById('app').innerHTML = `
        <div class="error-state">
          <span class="material-icons icon">search_off</span>
          <h2>Nota Tidak Ditemukan</h2>
          <p>${message || 'Nota dengan nomor tersebut tidak valid atau sudah tidak tersedia.'}</p>
          <a href="/">
            <span class="material-icons" style="font-size: 16px;">home</span>
            Kembali ke Beranda
          </a>
        </div>
      `;
    }

    function renderNota(nota) {
      const validasiUrl = SITE_URL + '/validasi/' + nota.no_nota;
      const waUrl = 'https://wa.me/' + formatWhatsApp(nota.whatsapp);

      const html = `
        <div class="nota-valid no-print">
          <span class="material-icons">verified</span>
          Nota ini telah diverifikasi dan valid
        </div>

        <div class="nota-container" id="nota-print">
          <div class="nota-header">
            <div class="brand">
              <svg viewBox="0 0 513 512" xmlns="http://www.w3.org/2000/svg">
                <path fill-rule="evenodd" fill="rgb(255, 255, 255)" d="M84.911,0.000 L429.089,0.000 C475.432,0.000 512.1000,37.568 512.1000,83.911 L512.1000,428.089 C512.1000,474.432 475.432,511.1000 429.089,511.1000 L84.911,511.1000 C38.568,511.1000 1.000,474.432 1.000,428.089 L1.000,83.911 C1.000,37.568 38.568,0.000 84.911,0.000 Z"/>
                <path fill-rule="evenodd" fill="rgb(20, 71, 230)" d="M447.263,256.242 C421.875,342.251 316.351,411.975 211.570,411.975 C129.379,411.975 72.074,369.069 63.433,309.059 L0.526,309.059 L0.526,300.365 L244.792,300.365 L268.125,211.490 L212.111,211.490 L201.839,250.614 L69.614,250.614 C74.202,237.059 80.775,223.947 88.1000,211.490 L0.526,211.490 L0.526,202.795 L214.393,202.795 L270.408,202.795 L283.469,153.045 L145.936,153.045 C190.202,120.826 246.959,100.509 303.510,100.509 C408.291,100.509 472.652,170.233 447.263,256.242 ZM186.495,309.059 L173.433,358.810 L326.929,358.810 L341.120,309.059 L186.495,309.059 Z"/>
              </svg>
              <div class="brand-name">Lincah<span>TRAVEL</span></div>
            </div>
            <div class="tagline">Cepat . Aman . Nyaman</div>
          </div>

          <div class="nota-body">
            <div class="nota-title">
              <div class="sub">Nota Perjalanan Dinas</div>
              <div class="no-nota">${nota.no_nota}</div>
            </div>

            <hr class="nota-divider" />

            <table class="nota-table">
              <tr>
                <td class="label">Nama</td>
                <td class="value">${capitalize(nota.nama)}</td>
              </tr>
              <tr>
                <td class="label">WhatsApp</td>
                <td class="value">${nota.whatsapp}</td>
              </tr>
              <tr>
                <td class="label">Rute</td>
                <td class="value">${capitalize(nota.dari)} → ${capitalize(nota.tujuan)}</td>
              </tr>
              <tr>
                <td class="label">Tanggal</td>
                <td class="value">${formatDate(nota.tanggal_berangkat)}</td>
              </tr>
              <tr>
                <td class="label">Jam</td>
                <td class="value">${nota.jam_berangkat}</td>
              </tr>
              <tr>
                <td class="label">No. Kursi</td>
                <td class="value">${nota.no_kursi}</td>
              </tr>
              <tr>
                <td class="label">Tarif</td>
                <td class="value"><span class="value-highlight">${formatCurrency(nota.tarif)}</span></td>
              </tr>
            </table>

            <div class="nota-qr-section">
              <div id="qr-container"></div>
              <div class="qr-label">Scan untuk verifikasi nota</div>
            </div>
          </div>

          <div class="nota-footer">
            <div class="company">Lincah Travel</div>
            <div>lincah.web.id • wa.me/${formatWhatsApp(nota.whatsapp)}</div>
            <div>Lorong Tj. Burung Utama, Bukit Lama, Kec. Ilir Bar. I, Kota Palembang 30139</div>
            <div class="disclaimer">Nota ini adalah bukti perjalanan dinas yang valid</div>
          </div>
        </div>

        <div class="action-bar no-print">
          <button class="btn-print" onclick="window.print()">
            <span class="material-icons" style="font-size: 18px;">print</span>
            Cetak Nota
          </button>
          <button class="btn-wa" onclick="window.open('${waUrl}', '_blank')">
            <span class="material-icons" style="font-size: 18px;">chat</span>
            Hubungi via WA
          </button>
        </div>
      `;

      document.getElementById('app').innerHTML = html;

      new QRCode(document.getElementById('qr-container'), {
        text: validasiUrl,
        width: 130,
        height: 130,
        colorDark: '#1e3a8a',
        colorLight: '#ffffff',
        correctLevel: QRCode.CorrectLevel.H
      });
    }

    async function main() {
      const id = getNotaId();

      if (!id) {
        showError('Tidak ada nomor nota yang ditemukan di URL.');
        return;
      }

      try {
        const { data, error } = await db
          .from('notas')
          .select('*')
          .eq('no_nota', id)
          .single();

        if (error || !data) {
          showError('Nota dengan nomor <strong>' + id + '</strong> tidak ditemukan atau sudah tidak tersedia.');
          return;
        }

        renderNota(data);
      } catch (err) {
        console.error('Error fetching nota:', err);
        showError('Terjadi kesalahan saat memuat data. Silakan coba lagi.');
      }
    }

    document.addEventListener('DOMContentLoaded', main);
  </script>
</body>
</html>
