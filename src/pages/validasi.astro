---
const siteTitle = 'Validasi Nota | Lincah Travel';
---

<!doctype html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>{siteTitle}</title>
  <meta name="description" content="Validasi Nota Perjalanan Lincah Travel" />
  <meta name="robots" content="noindex, nofollow" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet" />
  <script is:inline src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
  <style is:inline>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
      background: #0f172a;
      color: #1e293b;
      min-height: 100vh;
    }
    .loading-state {
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
      flex-direction: column;
      gap: 16px;
      background: #f1f5f9;
    }
    .loading-state .spinner {
      width: 40px; height: 40px;
      border: 4px solid #e2e8f0;
      border-top-color: #1e3a8a;
      border-radius: 50%;
      animation: spin 0.8s linear infinite;
    }
    @keyframes spin { to { transform: rotate(360deg); } }
    .loading-state p {
      font-size: 14px; color: #64748b; font-weight: 500;
    }
    .error-state {
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
      flex-direction: column;
      gap: 16px;
      padding: 24px;
      text-align: center;
      background: #f1f5f9;
    }
    .error-state .icon { font-size: 48px; color: #ef4444; }
    .error-state h2 { font-size: 20px; color: #1e293b; font-weight: 700; }
    .error-state p { font-size: 14px; color: #64748b; max-width: 400px; line-height: 1.6; }
    .error-state a {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 10px 24px;
      background: #1e3a8a;
      color: white;
      text-decoration: none;
      font-size: 13px;
      font-weight: 600;
      border-radius: 8px;
      margin-top: 8px;
    }

    .nota-wrapper {
      min-height: 100vh;
      background: #f1f5f9;
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 16px 12px;
    }
    .nota-valid {
      width: 100%;
      max-width: 420px;
      margin-bottom: 12px;
      text-align: center;
      padding: 10px;
      background: #ecfdf5;
      border: 1px solid #a7f3d0;
      font-size: 12px;
      font-weight: 600;
      color: #059669;
    }
    .nota-valid .material-icons {
      font-size: 16px;
      vertical-align: middle;
      margin-right: 4px;
    }

    .ticket {
      width: 100%;
      max-width: 420px;
      background: white;
      position: relative;
      overflow: hidden;
    }

    .ticket-notch-top,
    .ticket-notch-bottom {
      position: absolute;
      left: 50%;
      transform: translateX(-50%);
      width: 28px;
      height: 14px;
      background: #f1f5f9;
      z-index: 2;
    }
    .ticket-notch-top {
      top: 0;
      border-radius: 0 0 14px 14px;
    }
    .ticket-notch-bottom {
      bottom: 0;
      border-radius: 14px 14px 0 0;
    }

    .ticket-header {
      background: linear-gradient(135deg, #1e3a8a 0%, #1d4ed8 100%);
      padding: 20px 24px 28px;
      position: relative;
    }
    .ticket-header::after {
      content: '';
      position: absolute;
      bottom: -12px;
      left: 0;
      right: 0;
      height: 24px;
      background: radial-gradient(circle at 12px 0, transparent 11px, #1e3a8a 12px);
      background-size: 24px 24px;
      background-position: 0 0;
    }
    .ticket-header .brand-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .ticket-header .brand-left {
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .ticket-header .brand-left svg { width: 36px; height: 36px; flex-shrink: 0; }
    .ticket-header .brand-name {
      font-size: 18px;
      font-weight: 900;
      letter-spacing: -0.3px;
      text-transform: uppercase;
      color: white;
    }
    .ticket-header .brand-name span { color: #fbbf24; }
    .ticket-header .badge {
      font-size: 9px;
      font-weight: 800;
      letter-spacing: 0.5px;
      text-transform: uppercase;
      color: #1e3a8a;
      background: rgba(255,255,255,0.95);
      padding: 4px 10px;
    }

    .ticket-route {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 24px 24px 16px;
      position: relative;
      background: white;
    }
    .ticket-route::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 24px;
      right: 24px;
      height: 1px;
      background: repeating-linear-gradient(90deg, #cbd5e1 0, #cbd5e1 6px, transparent 6px, transparent 12px);
    }
    .route-point { text-align: center; flex: 1; }
    .route-point .label {
      font-size: 9px;
      font-weight: 700;
      color: #94a3b8;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      margin-bottom: 4px;
    }
    .route-point .city {
      font-size: 20px;
      font-weight: 900;
      color: #0f172a;
      text-transform: uppercase;
      letter-spacing: -0.3px;
    }
    .route-point .sub {
      font-size: 11px;
      color: #64748b;
      margin-top: 2px;
    }
    .route-arrow {
      flex-shrink: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 0 8px;
    }
    .route-arrow .material-icons {
      font-size: 28px;
      color: #1e3a8a;
    }
    .route-arrow .duration {
      font-size: 9px;
      font-weight: 600;
      color: #94a3b8;
      margin-top: 2px;
    }

    .ticket-details {
      padding: 20px 24px 16px;
      background: white;
    }
    .ticket-details .detail-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 14px 20px;
    }
    .ticket-details .detail-item { }
    .ticket-details .detail-item.full { grid-column: 1 / -1; }
    .ticket-details .detail-item .d-label {
      font-size: 9px;
      font-weight: 700;
      color: #94a3b8;
      letter-spacing: 1px;
      text-transform: uppercase;
      margin-bottom: 2px;
    }
    .ticket-details .detail-item .d-value {
      font-size: 15px;
      font-weight: 700;
      color: #0f172a;
    }
    .ticket-details .detail-item .d-value.small {
      font-size: 13px;
    }
    .ticket-details .detail-item .d-value.price {
      color: #1e3a8a;
      font-size: 20px;
      font-weight: 900;
    }

    .ticket-barcode {
      padding: 20px 24px 24px;
      background: white;
      position: relative;
    }
    .ticket-barcode::before {
      content: '';
      position: absolute;
      top: 0;
      left: 24px;
      right: 24px;
      height: 1px;
      background: repeating-linear-gradient(90deg, #cbd5e1 0, #cbd5e1 6px, transparent 6px, transparent 12px);
    }
    .ticket-barcode .barcode-inner {
      display: flex;
      align-items: center;
      gap: 16px;
      padding-top: 20px;
    }
    .ticket-barcode #qr-container {
      flex-shrink: 0;
      width: 100px;
      height: 100px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: white;
      border: 1px solid #e2e8f0;
      padding: 6px;
    }
    .ticket-barcode #qr-container img,
    .ticket-barcode #qr-container canvas {
      width: 100% !important;
      height: 100% !important;
    }
    .ticket-barcode .barcode-info { flex: 1; }
    .ticket-barcode .barcode-info .bi-label {
      font-size: 9px;
      font-weight: 700;
      color: #94a3b8;
      letter-spacing: 1px;
      text-transform: uppercase;
      margin-bottom: 4px;
    }
    .ticket-barcode .barcode-info .bi-text {
      font-size: 11px;
      color: #475569;
      line-height: 1.5;
    }
    .ticket-barcode .barcode-info .bi-text strong {
      color: #0f172a;
    }

    .ticket-footer {
      padding: 20px 24px 18px;
      background: #f8fafc;
      border-top: 1px solid #e2e8f0;
      text-align: center;
    }
    .ticket-footer .company {
      font-size: 13px;
      font-weight: 800;
      color: #1e3a8a;
      letter-spacing: 0.3px;
      margin-bottom: 8px;
    }
    .ticket-footer .contact-row {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 16px;
      font-size: 10px;
      color: #64748b;
      font-weight: 500;
    }
    .ticket-footer .contact-row span {
      display: inline-flex;
      align-items: center;
      gap: 4px;
    }
    .ticket-footer .contact-row .material-icons {
      font-size: 13px;
      color: #94a3b8;
    }
    .ticket-footer .tagline {
      margin-top: 8px;
      font-size: 9px;
      font-weight: 600;
      color: #94a3b8;
      letter-spacing: 1px;
    }
    .ticket-footer .disclaimer {
      margin-top: 10px;
      padding-top: 10px;
      border-top: 1px solid #e2e8f0;
      font-size: 9px;
      color: #cbd5e1;
      font-style: italic;
    }

    .action-bar {
      width: 100%;
      max-width: 420px;
      display: flex;
      gap: 10px;
      margin-top: 16px;
    }
    .action-bar button {
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      padding: 14px;
      font-size: 13px;
      font-weight: 700;
      font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
      border: none;
      cursor: pointer;
      transition: all 0.2s;
    }
    .action-bar .btn-print {
      background: white;
      color: #1e3a8a;
      border: 2px solid #1e3a8a;
    }
    .action-bar .btn-print:hover { background: #f1f5f9; }
    .action-bar .btn-print .material-icons { font-size: 18px; }
    .action-bar .btn-wa {
      background: #25D366;
      color: white;
    }
    .action-bar .btn-wa:hover { background: #1da851; }
    .action-bar .btn-wa .material-icons { font-size: 18px; }

    .ticket-no {
      font-size: 10px;
      font-weight: 700;
      color: #94a3b8;
      letter-spacing: 0.3px;
      text-align: center;
      padding: 6px 0 0;
      background: white;
    }

    @media (max-width: 480px) {
      .nota-wrapper { padding: 10px 8px; }
      .ticket-header { padding: 16px 16px 24px; }
      .ticket-route { padding: 20px 16px 14px; }
      .ticket-route::after { left: 16px; right: 16px; }
      .ticket-details { padding: 16px 16px 12px; }
      .ticket-details .detail-grid { gap: 12px 16px; }
      .ticket-barcode { padding: 16px 16px 20px; }
      .ticket-barcode::before { left: 16px; right: 16px; }
      .ticket-barcode #qr-container { width: 80px; height: 80px; }
      .ticket-footer { padding: 16px 16px 14px; }
      .ticket-footer .contact-row { gap: 12px; flex-wrap: wrap; }
      .route-point .city { font-size: 17px; }
      .action-bar { flex-direction: column; gap: 8px; }
      .action-bar button { padding: 12px; }
      .ticket-details .detail-item .d-value.price { font-size: 18px; }
    }

    @media (min-width: 768px) {
      .nota-wrapper { padding: 32px 16px; }
    }

    @media print {
      body { background: white !important; }
      .nota-wrapper { min-height: auto; padding: 0; background: white; }
      .action-bar, .nota-valid, .no-print { display: none !important; }
      .ticket { max-width: 100%; box-shadow: none; }
      .ticket-notch-top,
      .ticket-notch-bottom { background: white; }
      .ticket-header { background: #1e3a8a !important; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
      .ticket-header .brand-name span { color: #fbbf24 !important; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
      .ticket-header .badge { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
      .ticket-footer { background: #f8fafc !important; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
      @page { margin: 8mm; }
    }
  </style>
</head>
<body>
  <div id="app">
    <div class="loading-state" id="loading-state">
      <div class="spinner"></div>
      <p>Memuat data nota...</p>
    </div>
  </div>

  <script is:inline>
    const { createClient } = supabase;
    const db = createClient(
      'https://wrllosddilihcoqofhdr.supabase.co',
      'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6IndybGxvc2RkaWxpaGNvcW9maGRyIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODIwMzEzMDgsImV4cCI6MjA5NzYwNzMwOH0.Om4UkzVF0Qobqkva5yZuKu5FSAg8GI00dYUiOaaIsPQ'
    );
    const SITE_URL = 'https://lincahtravel.web.id';

    function getNotaId() {
      const pathMatch = window.location.pathname.match(/\/validasi\/(.+)/);
      if (pathMatch) return pathMatch[1];
      const params = new URLSearchParams(window.location.search);
      return params.get('id') || '';
    }

    function formatDate(dateStr) {
      if (!dateStr) return '-';
      const d = new Date(dateStr);
      const opts = { day: 'numeric', month: 'long', year: 'numeric' };
      return d.toLocaleDateString('id-ID', opts);
    }

    function formatDateShort(dateStr) {
      if (!dateStr) return '-';
      const d = new Date(dateStr);
      const opts = { day: 'numeric', month: 'short', year: 'numeric' };
      return d.toLocaleDateString('id-ID', opts);
    }

    function formatCurrency(amount) {
      const num = Number(amount) || 0;
      return 'Rp ' + num.toLocaleString('id-ID');
    }

    function capitalize(str) {
      if (!str) return '';
      return str.split(' ').map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(' ');
    }

    function showError(message) {
      document.getElementById('app').innerHTML = `
        <div class="error-state">
          <span class="material-icons icon">search_off</span>
          <h2>Nota Tidak Ditemukan</h2>
          <p>${message || 'Nota dengan nomor tersebut tidak valid atau sudah tidak tersedia.'}</p>
          <a href="/">
            <span class="material-icons" style="font-size: 16px;">home</span>
            Kembali ke Beranda
          </a>
        </div>
      `;
    }

    function renderNota(nota) {
      const validasiUrl = SITE_URL + '/validasi/' + nota.no_nota;
      const tglLong = formatDate(nota.tanggal_berangkat);
      const tglShort = formatDateShort(nota.tanggal_berangkat);

      const html = `
        <div class="nota-wrapper">
          <div class="nota-valid no-print">
            <span class="material-icons">verified</span>
            Nota telah diverifikasi dan valid
          </div>

          <div class="ticket" id="nota-print">
            <div class="ticket-notch-top"></div>

            <div class="ticket-header">
              <div class="brand-row">
                <div class="brand-left">
                  <svg viewBox="0 0 513 512" xmlns="http://www.w3.org/2000/svg">
                    <path fill-rule="evenodd" fill="rgb(255, 255, 255)" d="M84.911,0.000 L429.089,0.000 C475.432,0.000 512.1000,37.568 512.1000,83.911 L512.1000,428.089 C512.1000,474.432 475.432,511.1000 429.089,511.1000 L84.911,511.1000 C38.568,511.1000 1.000,474.432 1.000,428.089 L1.000,83.911 C1.000,37.568 38.568,0.000 84.911,0.000 Z"/>
                    <path fill-rule="evenodd" fill="rgb(20, 71, 230)" d="M447.263,256.242 C421.875,342.251 316.351,411.975 211.570,411.975 C129.379,411.975 72.074,369.069 63.433,309.059 L0.526,309.059 L0.526,300.365 L244.792,300.365 L268.125,211.490 L212.111,211.490 L201.839,250.614 L69.614,250.614 C74.202,237.059 80.775,223.947 88.1000,211.490 L0.526,211.490 L0.526,202.795 L214.393,202.795 L270.408,202.795 L283.469,153.045 L145.936,153.045 C190.202,120.826 246.959,100.509 303.510,100.509 C408.291,100.509 472.652,170.233 447.263,256.242 ZM186.495,309.059 L173.433,358.810 L326.929,358.810 L341.120,309.059 L186.495,309.059 Z"/>
                  </svg>
                  <div class="brand-name">Lincah<span>TRAVEL</span></div>
                </div>
                <div class="badge">Valid</div>
              </div>
            </div>

            <div class="ticket-route">
              <div class="route-point">
                <div class="label">Dari</div>
                <div class="city">${capitalize(nota.dari)}</div>
              </div>
              <div class="route-arrow">
                <span class="material-icons">arrow_forward</span>
              </div>
              <div class="route-point">
                <div class="label">Tujuan</div>
                <div class="city">${capitalize(nota.tujuan)}</div>
              </div>
            </div>

            <div class="ticket-details">
              <div class="detail-grid">
                <div class="detail-item">
                  <div class="d-label">Penumpang</div>
                  <div class="d-value small">${capitalize(nota.nama)}</div>
                </div>
                <div class="detail-item">
                  <div class="d-label">Kursi</div>
                  <div class="d-value small">${nota.no_kursi}</div>
                </div>
                <div class="detail-item">
                  <div class="d-label">Keberangkatan</div>
                  <div class="d-value small">${tglLong}</div>
                </div>
                <div class="detail-item">
                  <div class="d-label">Jam</div>
                  <div class="d-value small">${nota.jam_berangkat}</div>
                </div>
                <div class="detail-item full" style="margin-top:6px;">
                  <div class="d-label">Tarif</div>
                  <div class="d-value price">${formatCurrency(nota.tarif)}</div>
                </div>
              </div>
            </div>

            <div class="ticket-barcode">
              <div class="barcode-inner">
                <div id="qr-container"></div>
                <div class="barcode-info">
                  <div class="bi-label">Verifikasi Nota</div>
                  <div class="bi-text">
                    Scan QR code untuk memverifikasi keabsahan nota perjalanan ini.<br>
                    <strong>${nota.no_nota.replace(/^NOTA-/, '')}</strong>
                  </div>
                </div>
              </div>
            </div>

            <div class="ticket-footer">
              <div class="company">LINCAH TRAVEL</div>
              <div class="contact-row">
                <span><span class="material-icons">public</span> lincahtravel.web.id</span>
              </div>
              <div class="tagline">Cepat . Aman . Nyaman</div>
              <div class="disclaimer">Nota ini adalah bukti perjalanan dinas yang valid</div>
            </div>

            <div class="ticket-notch-bottom"></div>
          </div>

          <div class="action-bar no-print">
            <button class="btn-print" onclick="window.print()">
              <span class="material-icons">print</span>
              Cetak Nota
            </button>

          </div>
        </div>
      `;

      document.getElementById('app').innerHTML = html;

      new QRCode(document.getElementById('qr-container'), {
        text: validasiUrl,
        width: 100,
        height: 100,
        colorDark: '#1e3a8a',
        colorLight: '#ffffff',
        correctLevel: QRCode.CorrectLevel.H
      });
    }

    async function main() {
      const id = getNotaId();
      if (!id) {
        showError('Tidak ada nomor nota yang ditemukan di URL.');
        return;
      }
      try {
        const { data, error } = await db
          .from('notas')
          .select('*')
          .eq('no_nota', id)
          .single();
        if (error || !data) {
          showError('Nota dengan nomor <strong>' + id + '</strong> tidak ditemukan atau sudah tidak tersedia.');
          return;
        }
        renderNota(data);
      } catch (err) {
        console.error('Error fetching nota:', err);
        showError('Terjadi kesalahan saat memuat data. Silakan coba lagi.');
      }
    }

    main();
  </script>
</body>
</html>
