---
interface Props {
	title: string;
	description?: string;
	canonical?: string;
}

const { title, description = "Layanan Lincah Travel Terpercaya", canonical } = Astro.props;
const canonicalURL = new URL(canonical || Astro.url.pathname, Astro.site).href;
import '../index.css';
import FloatingWhatsApp from '../components/FloatingWhatsApp.astro';

---

<!doctype html>
<html lang="id" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="canonical" href={canonicalURL} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<script type="application/ld+json">
			{
			  "@context": "https://schema.org",
			  "@type": "TravelAgency",
			  "name": "Lincah Travel Palembang",
			  "image": "https://lincahtravel.web.id/favicon.png",
			  "address": {
			    "@type": "PostalAddress",
			    "streetAddress": "Lorong Tj. Burung Utama, Bukit Lama, Kec. Ilir Bar. I",
			    "addressLocality": "Kota Palembang",
			    "addressRegion": "Sumatera Selatan",
			    "postalCode": "30139",
			    "addressCountry": "ID"
			  },
			  "telephone": "+6281369231893",
			  "url": "https://lincahtravel.web.id/"
			}
		</script>
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,200..800;1,200..800&display=swap" rel="stylesheet">
		<link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
		<style is:global>
			:root {
				--accent: 136, 58, 234;
				--accent-light: 224, 204, 250;
				--accent-dark: 49, 10, 101;
				--accent-gradient: linear-gradient(
					45deg,
					rgb(var(--accent)),
					rgb(var(--accent-light)) 30%,
					white 60%
				);
			}
			html {
				font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
				background: #ffffff;
			}
			body {
				margin: 0;
				padding-bottom: 64px;
			}
			@media (min-width: 1024px) {
				body {
					padding-bottom: 0;
				}
			}
		</style>
	</head>
  <body>
    <slot />
    <FloatingWhatsApp />
  </body>

</html>
