---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

interface Props {
  currentRouteId?: string;
}

const { currentRouteId } = Astro.props;

const allRoutes = await getCollection('rute') as CollectionEntry<'rute'>[];

// Rute satu koridor tampil lebih dulu di sidebar (lihat PENGETAHUAN-KORIDOR-RUTE.md)
const corridorMap: Record<string, string[]> = {
  'palembang-jambi': ['palembang-sungai-lilin', 'palembang-bayung-lencir', 'palembang-betung', 'palembang-kuala-tungkal', 'palembang-muara-bulian'],
  'palembang-sekayu': ['palembang-betung', 'palembang-jambi', 'palembang-lubuklinggau'],
  'palembang-lubuklinggau': ['palembang-lahat', 'palembang-muara-enim', 'palembang-pagaralam', 'palembang-tebing', 'palembang-pendopo-lintang', 'palembang-kikim'],
  'palembang-pagaralam': ['palembang-lahat', 'palembang-lubuklinggau', 'palembang-kikim', 'palembang-pendopo-lintang'],
  'palembang-muara-dua': ['palembang-martapura', 'palembang-baturaja', 'palembang-belitang', 'palembang-danau-ranau'],
  'palembang-kayuagung': ['palembang-indralaya', 'palembang-prabumulih'],
};

const relatedFirst = (currentRouteId && corridorMap[currentRouteId]) || [];

// Jangan tampilkan link ke halaman yang sedang dibuka
const utamaRoutes = allRoutes
  .filter(route => route.data.type === 'utama' && route.id !== currentRouteId)
  .sort((a, b) => {
    const ai = relatedFirst.indexOf(a.id);
    const bi = relatedFirst.indexOf(b.id);
    if (ai === -1 && bi === -1) return 0;
    if (ai === -1) return 1;
    if (bi === -1) return -1;
    return ai - bi;
  });

// Tambahkan maksimal 2 rute se-koridor yang belum masuk daftar utama (mis. Sungai Lilin untuk koridor Jambi)
const utamaIds = new Set(utamaRoutes.map(r => r.id));
const relatedExtra = relatedFirst
  .filter(id => id !== currentRouteId && !utamaIds.has(id))
  .map(id => allRoutes.find(route => route.id === id))
  .filter((route): route is CollectionEntry<'rute'> => Boolean(route))
  .slice(0, Math.max(0, 7 - utamaRoutes.length));

const sidebarRoutes = [...utamaRoutes, ...relatedExtra];

const cityImagesData = await getCollection('city_images');
const cityImages = cityImagesData[0]?.data.cities || {};

const slugify = (str: string) => str.toLowerCase().replace(/\s+/g, '-').replace(/[()]/g, '');
---

<div class="mt-8 w-full">
  <h2 class="text-lg font-bold text-blue-900 mb-4">Rute Utama</h2>
  <div class="flex flex-col gap-3">
    {sidebarRoutes.map(route => {
      const from = route.data.from;
      const to = route.data.to;
      const slugFrom = slugify(from);
      const slugTo = slugify(to);
      
      const displayFrom = from.charAt(0).toUpperCase() + from.slice(1);
      const displayTo = to.charAt(0).toUpperCase() + to.slice(1);
      
      const img = cityImages[slugTo] || "/img/travel-icon.webp";
      
      return (
        <a href={`/${slugFrom}/${slugTo}`} class="flex items-center gap-3 p-3 bg-slate-50 rounded-lg hover:bg-slate-100 transition-colors">
          <img src={img} alt={`Travel ${displayFrom} ${displayTo}`} width="64" height="48" class="w-16 h-12 object-cover rounded">
          <div class="flex-1 min-w-0">
            <h3 class="text-sm font-bold text-blue-900 truncate">{displayFrom} - {displayTo}</h3>
            <div class="mt-1">
              <span class="text-xs font-medium text-slate-600">Rp {route.data.price.toLocaleString('id-ID')}</span>
            </div>
          </div>
        </a>
      );
    })}
  </div>
</div>