---
import { getCollection } from 'astro:content';

// Ambil semua blog posts untuk internal linking
const allBlogPosts = await getCollection('blog', (post) => {
  return true;
});

// Ambil post yang sedang dilihat untuk menentukan related posts
const { currentPostId } = Astro.props;

// Urutkan posts terbaru terlebih dahulu
const latestPosts = [...allBlogPosts]
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime())
  .slice(0, 5);

// Filter posts berdasarkan kategori yang sama (tidak termasuk current post)
let similarCategoryPosts = [];
if (currentPostId) {
  const currentPost = allBlogPosts.find(p => p.id === currentPostId);
  if (currentPost) {
    similarCategoryPosts = allBlogPosts
      .filter(post => post.id !== currentPostId && post.data.kategori === currentPost.data.kategori)
      .slice(0, 3);
  }
}

// Ekstrak dan hitung semua tags
const tagCount = {};
allBlogPosts.forEach(post => {
  if (post.data.tags) {
    post.data.tags.forEach(tag => {
      tagCount[tag] = (tagCount[tag] || 0) + 1;
    });
  }
});

// Ambil 10 tags terpopuler
const popularTags = Object.entries(tagCount)
  .sort((a, b) => b[1] - a[1])
  .slice(0, 10);
---

<div class="space-y-6">
  <!-- Posts Terbaru -->
  {latestPosts.length > 0 && (
    <div class="bg-white rounded-xl border border-slate-100 p-4 shadow-sm">
      <h3 class="text-base font-bold text-slate-900 mb-3 pb-2 border-b border-slate-100 flex items-center gap-2">
        <span class="material-symbols-outlined text-lg text-blue-600">newspaper</span>
        Artikel Terbaru
      </h3>
      <ul class="space-y-2">
        {latestPosts.map((post) => (
          <li>
            <a 
              href={`/blog/${post.data.slug}`}
              class="flex items-start gap-2 py-1.5 hover:bg-slate-50 px-2 rounded transition-colors"
            >
              <div class="w-8 h-8 flex-shrink-0 overflow-hidden rounded bg-slate-100">
                <img
                  src={post.data.image_url || "/img/hero_ampera_sunset_1781441848926.webp"}
                  alt={post.data.title}
                  width="32" height="32"
                  class="w-full h-full object-cover"
                  loading="lazy"
                />
              </div>
              <div class="min-w-0">
                <h4 class="text-xs font-semibold text-slate-800 line-clamp-2 leading-tight">
                  {post.data.title}
                </h4>
                <span class="text-[10px] text-slate-500">
                  {new Date(post.data.pubDate).toLocaleDateString('id-ID', { 
                    day: 'numeric', 
                    month: 'short' 
                  })}
                </span>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </div>
  )}

  <!-- Posts dengan Kategori Sama -->
  {similarCategoryPosts.length > 0 && (
    <div class="bg-white rounded-xl border border-slate-100 p-4 shadow-sm">
      <h3 class="text-base font-bold text-slate-900 mb-3 pb-2 border-b border-slate-100 flex items-center gap-2">
        <span class="material-symbols-outlined text-lg text-blue-600">menu_book</span>
        Artikel Serupa
      </h3>
      <ul class="space-y-2">
        {similarCategoryPosts.map((post) => (
          <li>
            <a 
              href={`/blog/${post.data.slug}`}
              class="block py-1.5 px-2 rounded hover:bg-slate-50 transition-colors"
            >
              <span class="text-xs font-medium text-slate-800 line-clamp-2">
                {post.data.title}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  )}

  <!-- Popular Tags -->
  {popularTags.length > 0 && (
    <div class="bg-white rounded-xl border border-slate-100 p-4 shadow-sm">
      <h3 class="text-base font-bold text-slate-900 mb-3 pb-2 border-b border-slate-100 flex items-center gap-2">
        <span class="material-symbols-outlined text-lg text-blue-600">sell</span>
        Topik Populer
      </h3>
      <div class="flex flex-wrap gap-2">
        {popularTags.map(([tag, count]) => (
          <a 
            href={`/blog?tag=${encodeURIComponent(tag)}`}
            class="inline-flex items-center gap-1 px-3 py-1.5 text-xs bg-blue-50 text-blue-700 hover:bg-blue-100 rounded-full transition-colors"
          >
            #{tag}
            <span class="text-[10px] text-blue-500">({count})</span>
          </a>
        ))}
      </div>
    </div>
  )}
</div>