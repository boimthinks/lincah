---
import { getCollection } from 'astro:content';

// Ambil semua blog posts untuk internal linking
const allBlogPosts = await getCollection('blog', (post) => {
  return true;
});

// Urutkan posts terbaru terlebih dahulu
const latestPosts = [...allBlogPosts]
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime())
  .slice(0, 5);
---

{latestPosts.length > 0 && (
  <div class="bg-white rounded-xl border border-slate-100 p-4 shadow-sm">
    <h3 class="text-base font-bold text-slate-900 mb-3 pb-2 border-b border-slate-100 flex items-center gap-2">
      <span class="material-symbols-outlined text-lg text-blue-600">newspaper</span>
      Artikel Terbaru
    </h3>
    <ul class="space-y-2">
      {latestPosts.map((post) => (
        <li>
          <a 
            href={`/blog/${post.data.slug}`}
            class="flex items-start gap-2 py-1.5 hover:bg-slate-50 px-2 rounded transition-colors"
          >
            <div class="w-8 h-8 flex-shrink-0 overflow-hidden rounded bg-slate-100">
              <img
                src={post.data.image_url || "/img/hero_ampera_sunset_1781441848926.webp"}
                alt={post.data.title}
                width="32" height="32"
                class="w-full h-full object-cover"
                loading="lazy"
              />
            </div>
            <div class="min-w-0">
              <h4 class="text-xs font-semibold text-slate-800 line-clamp-2 leading-tight">
                {post.data.title}
              </h4>
              <span class="text-[10px] text-slate-500">
                {new Date(post.data.pubDate).toLocaleDateString('id-ID', { 
                  day: 'numeric', 
                  month: 'short' 
                })}
              </span>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </div>
)}
